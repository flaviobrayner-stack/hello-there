# Backend de matrícula — somente ambiente de desenvolvimento.
# Nunca configure chaves secret/service-role no navegador, no Git ou em variáveis VITE_*.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável atual do Supabase (sb_publishable_...). Não é a secret key.
SUPABASE_PUBLISHABLE_KEY=SUBSTITUA_PELA_CHAVE_PUBLICAVEL
# Compatibilidade opcional com projetos que ainda usam a chave anon legada:
# SUPABASE_ANON_KEY=SUBSTITUA_PELA_CHAVE_ANON
# Permanecem false até aplicar schema revisado e passar os testes de autorização.
MATRICULA_BACKEND_ENABLED=false
MATRICULA_ACCESS_POLICY_APPROVED=false
